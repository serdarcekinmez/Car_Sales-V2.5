# Copy to .streamlit/secrets.toml for a local `streamlit run` (git-ignored), or paste the
# same lines into Streamlit Community Cloud > App settings > Secrets. Never commit real values.

# Pilot account (python pipeline/run_demo.py hash-password prints the hash line).
GARAJ_DEMO_USERNAME = "pilot"
GARAJ_DEMO_PASSWORD_HASH = "scrypt:16384:8:1:..."

# Data + models zip made by `python pipeline/pack_demo_data.py`, kept in PRIVATE storage.
# Example (private Hugging Face dataset):
#   https://huggingface.co/datasets/<kullanici>/<depo>/resolve/main/garaj_demo_data.zip
GARAJ_DEMO_DATA_URL = ""
# Read-only access token for that address (sent as "Authorization: Bearer ...").
GARAJ_DEMO_DATA_TOKEN = ""
