# Phase 8 demo settings. Copy to .env (git-ignored), fill in, never commit .env.
# One pilot customer per deployment.

# Pilot account user name (no spaces at the ends, at most 64 characters).
GARAJ_DEMO_USERNAME=

# Salted scrypt hash of the pilot password. Generate it with
#   python pipeline/run_demo.py hash-password
# and paste the whole line it prints here. Never put the plain password in this file.
GARAJ_DEMO_PASSWORD_HASH=

# Public host name(s) the browser uses, comma-separated (e.g. demo.example.com).
# Required behind HTTPS; empty = 127.0.0.1 / localhost only.
GARAJ_DEMO_ALLOWED_HOSTS=

# Reverse-proxy IP addresses whose X-Forwarded-For header may be trusted for login
# throttling, comma-separated (e.g. 172.17.0.1 for a proxy on the Docker host).
# Empty = the header is ignored.
GARAJ_DEMO_TRUSTED_PROXIES=

# Session lifetime in hours (0.25 - 24).
GARAJ_DEMO_SESSION_HOURS=8

# Optional. Data / model root and the writable SQLite store. Defaults: this repository and
# Datasets/phase8_demo/demo.sqlite3. The Docker image sets both (/data and
# /var/lib/garaj-demo/demo.sqlite3); leave them commented out there.
# GARAJ_DEMO_ROOT=
# GARAJ_DEMO_STORE=
